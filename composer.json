{
  "name": "pjaudiomv/lean-google-login",
  "description": "Lean Google Login WordPress plugin - adds a Sign in with Google (OAuth2) button to wp-login.php, with an optional Workspace domain allow-list.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "pjaudiomv"
    }
  ],
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.3",
    "phpunit/phpunit": "^9.6",
    "wp-phpunit/wp-phpunit": "^6.8",
    "yoast/phpunit-polyfills": "^4.0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.3.0"
    }
  }
}
